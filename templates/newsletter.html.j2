<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Group Finance AI Buzz - {{ issue_title }}</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #dde2ef;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      color: #1c1c1c;
    }

    .wrapper {
      max-width: 620px;
      margin: 32px auto;
      background: #ffffff;
    }

    /* ── Header gradient bar ── */
    .header-gradient-bar {
      height: 6px;
      background: linear-gradient(to right, #0c1540, #2a5aad, #c4a8b8, #8b1535);
    }

    /* ── Header ── */
    .header {
      background: #0c1540;
      padding: 24px 36px 26px;
      border-bottom: 3px solid #8b1535;
    }
    .header-inner {
      display: flex;
      align-items: center;
      gap: 20px;
    }
    .header-logo {
      flex-shrink: 0;
    }
    .header-logo svg {
      width: 68px;
      height: 68px;
      display: block;
    }
    .header-text {
      flex: 1;
    }
    .header .label {
      font-size: 10px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #8899cc;
      margin-bottom: 8px;
    }
    .header h1 {
      font-size: 18px;
      font-weight: 700;
      color: #f0f4ff;
      letter-spacing: 0.3px;
      line-height: 1.3;
    }
    .header .issue-date {
      font-size: 12px;
      font-weight: 400;
      color: #8899cc;
      margin-top: 4px;
    }
    /* ── Stories container ── */
    .stories {
      padding: 0 36px;
    }

    /* ── Story ── */
    .story {
      padding: 18px 0 14px;
      border-bottom: 1px solid #f0f0f0;
    }
    .story:last-child {
      border-bottom: none;
      padding-bottom: 20px;
    }
    .story-headline {
      margin-bottom: 7px;
    }
    .story h3 {
      font-size: 13px;
      font-weight: 700;
      color: #0c1540;
      line-height: 1.4;
      margin: 0 0 5px 0;
    }
    .story h3 a {
      color: #2a5aad;
      text-decoration: none;
    }
    .story h3 a:hover {
      text-decoration: underline;
    }
    .story-tag {
      display: inline-block;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #fff;
      background: #8b1535;
      border-radius: 10px;
      padding: 2px 8px;
      white-space: nowrap;
      vertical-align: middle;
      flex-shrink: 0;
    }
    .story p {
      font-size: 12px;
      line-height: 1.7;
      color: #555;
    }
    .story p strong {
      color: #444;
      font-weight: 600;
    }


    /* ── Digest ── */
    .digest {
      padding: 24px 36px;
      background: #f0f3fa;
      border-bottom: 2px solid #c4a8b8;
    }
    .digest .digest-label {
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: #8b1535;
      margin-bottom: 10px;
    }
    .digest p {
      font-size: 12px;
      line-height: 1.75;
      color: #333;
    }

    /* ── Footer ── */
    .footer {
      background: #0c1540;
      padding: 18px 36px;
      font-size: 10px;
      color: #6677aa;
      letter-spacing: 0.3px;
      border-top: 3px solid #8b1535;
    }
  </style>
</head>
<body>
<div class="wrapper">

  <div class="header-gradient-bar"></div>

  <div class="header">
    <div class="header-inner">
      <div class="header-logo">
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <!-- Outer ring -->
          <circle cx="50" cy="50" r="47" fill="#1a2b6e" stroke="#8b1535" stroke-width="5"/>
          <!-- Chart line -->
          <polyline points="18,74 38,60 57,47 71,31" fill="none" stroke="white" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
          <!-- Chart dots -->
          <circle cx="18" cy="74" r="5" fill="#8b1535"/>
          <circle cx="38" cy="60" r="5" fill="#8b1535"/>
          <circle cx="57" cy="47" r="4.5" fill="white"/>
          <!-- Bulb glow halo -->
          <circle cx="71" cy="29" r="13" fill="white" opacity="0.18"/>
          <!-- Bulb body -->
          <circle cx="71" cy="27" r="9" fill="white"/>
          <!-- Bulb base ridges -->
          <rect x="67.5" y="35" width="7" height="2.5" rx="1" fill="#8b1535"/>
          <rect x="67.5" y="38.5" width="7" height="2" rx="1" fill="#8b1535"/>
          <!-- Lightning bolt inside bulb -->
          <polyline points="73,21 69.5,27.5 73,27.5 70,34" fill="none" stroke="#8b1535" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <!-- Rays -->
          <line x1="71" y1="13" x2="71" y2="10" stroke="#f0c040" stroke-width="2.2" stroke-linecap="round"/>
          <line x1="83" y1="17" x2="85.5" y2="14.5" stroke="#f0c040" stroke-width="2.2" stroke-linecap="round"/>
          <line x1="87" y1="27" x2="90" y2="27" stroke="#f0c040" stroke-width="2.2" stroke-linecap="round"/>
          <line x1="59" y1="17" x2="56.5" y2="14.5" stroke="#f0c040" stroke-width="2.2" stroke-linecap="round"/>
          <line x1="55" y1="27" x2="52" y2="27" stroke="#f0c040" stroke-width="2.2" stroke-linecap="round"/>
        </svg>
      </div>
      <div class="header-text">
        <h1>Group Finance AI Buzz &mdash; {{ issue_title }}</h1>
        <div class="issue-date">{{ issue_date }}</div>
      </div>
    </div>
  </div>

  {% if digest %}
  <div class="digest">
    <div class="digest-label">Edition in Brief</div>
    <p>{{ digest | safe }}</p>
  </div>
  {% endif %}

  <div class="stories">
    {% for section in sections %}{% for story in section.stories %}
    <div class="story">
      <div class="story-headline">
        <h3>{% if story.source_url %}<a href="{{ story.source_url }}" target="_blank" rel="noopener">{{ story.headline }}</a>{% else %}{{ story.headline }}{% endif %}</h3>
        <div><span class="story-tag">{{ section.label | replace(section.label[:3], '', 1) | trim }}</span></div>
      </div>
      <p>{{ story.body_html | safe }}</p>
    </div>
    {% endfor %}{% endfor %}
  </div>

  <div class="footer">
    If you have interesting AI news, feel free to share it to the Group Finance AI Buzz Team.
  </div>

</div>
</body>
</html>
